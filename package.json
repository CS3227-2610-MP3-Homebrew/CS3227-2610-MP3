{
  "name": "homebrew",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "bun run check:isolation && next build --webpack && bun run check:isolation:artifacts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:start": "bun scripts/database.ts start",
    "db:reset": "bun scripts/database.ts reset",
    "db:check": "bun scripts/database.ts check",
    "check:traceability": "bun workflow/scripts/check-traceability.ts",
    "check:specs": "bun workflow/scripts/check-specs.ts",
    "check:isolation": "bun scripts/check-isolation.ts",
    "check:isolation:artifacts": "bun scripts/check-isolation.ts --artifacts",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run check:traceability && bun run check:specs && bun run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
