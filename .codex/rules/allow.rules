prefix_rule(
    pattern = ["bun", "run", "db:start"],
    decision = "allow",
    justification = "The local Supabase Docker stack needs to run outside the sandbox; the core-schema task adds this script.",
    match = ["bun run db:start"],
    not_match = [
        "bun run db:start-all",
        "bun run db:reset-all",
        "supabase db reset",
        "bun run verify",
    ],
)

prefix_rule(
    pattern = ["bun", "run", "db:reset"],
    decision = "allow",
    justification = "Replaying migrations on the local Supabase Docker stack needs to run outside the sandbox; the core-schema task adds this script.",
    match = ["bun run db:reset"],
    not_match = [
        "bun run db:reset-all",
        "supabase db reset",
        "bun run verify",
    ],
)

prefix_rule(
    pattern = ["bun", "run", "verify"],
    decision = "allow",
    justification = "The Next.js/Turbopack build needs a local port that the sandbox blocks; verify runs lint, typecheck, unit/integration tests, the traceability and spec checks, and build.",
    match = ["bun run verify"],
    not_match = [
        "bun run dev",
        "bun run build",
        "bun run lint",
        "bun install",
        "bunx vercel deploy",
        "bun run verify-all",
    ],
)

prefix_rule(
    pattern = ["bun", "run", "test:e2e"],
    decision = "allow",
    justification = "Playwright needs a local server port and a browser, which the sandbox blocks.",
    match = ["bun run test:e2e"],
    not_match = [
        "bun run test",
        "bun run dev",
        "bun run build",
        "bun install",
        "bunx playwright install",
        "bun run test:e2e-all",
    ],
)

prefix_rule(
    pattern = ["bun", "run", ["test", "db:check"]],
    decision = "allow",
    justification = "Subsets of the already-allowed `bun run verify`; database tests and the RLS catalogue check need the local Supabase Docker stack outside the sandbox.",
    match = ["bun run test", "bun run test tests/integration/usage", "bun run db:check"],
    not_match = [
        "bun run test:e2e-all",
        "bun run dev",
        "bun install",
        "bun run db:push",
    ],
)

prefix_rule(
    pattern = ["bun", "install", "--frozen-lockfile"],
    decision = "allow",
    justification = "Installs exactly the committed lockfile and needs network access. Adding or changing dependencies (`bun add`, plain `bun install`) still prompts.",
    match = ["bun install --frozen-lockfile"],
    not_match = ["bun install", "bun add zod", "bun add -d yaml"],
)
